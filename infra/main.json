              "defaultValue": "16",
              "allowedValues": [
                "14",
                "15",
                "16"
              ],
              "metadata": {
                "description": "PostgreSQL version"
              }
            },
            "storageSizeGB": {
              "type": "int",
              "defaultValue": 32,
              "metadata": {
                "description": "Storage size in GB"
              }
            },
            "highAvailabilityMode": {
              "type": "string",
              "defaultValue": "Disabled",
              "allowedValues": [
                "Disabled",
                "SameZone",
                "ZoneRedundant"
              ],
              "metadata": {
                "description": "High availability mode"
              }
            },
            "databaseName": {
              "type": "string",
              "defaultValue": "assets_manager",
              "metadata": {
                "description": "Database name"
              }
            },
            "tags": {
              "type": "object",
              "defaultValue": {},
              "metadata": {
                "description": "Tags to apply to resources"
              }
            },
            "webAppObjectId": {
              "type": "string",
              "metadata": {
                "description": "Object ID of the web app managed identity (for AAD admin)"
              }
            },
            "webAppIdentityName": {
              "type": "string",
              "metadata": {
                "description": "Name of the web app managed identity"
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.DBforPostgreSQL/flexibleServers",
              "apiVersion": "2022-12-01",
              "name": "[parameters('serverName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "sku": {
                "name": "[parameters('skuName')]",
                "tier": "[parameters('skuTier')]"
              },
              "properties": {
                "version": "[parameters('postgresVersion')]",
                "administratorLogin": "[parameters('administratorLogin')]",
                "administratorLoginPassword": "[parameters('administratorPassword')]",
                "storage": {
                  "storageSizeGB": "[parameters('storageSizeGB')]"
                },
                "backup": {
                  "backupRetentionDays": 7,
                  "geoRedundantBackup": "Disabled"
                },
                "highAvailability": {
                  "mode": "[parameters('highAvailabilityMode')]"
                },
                "authConfig": {
                  "activeDirectoryAuth": "Enabled",
                  "passwordAuth": "Enabled"
                }
              }
            },
            {
              "type": "Microsoft.DBforPostgreSQL/flexibleServers/databases",
              "apiVersion": "2022-12-01",
              "name": "[format('{0}/{1}', parameters('serverName'), parameters('databaseName'))]",
              "properties": {
                "charset": "UTF8",
                "collation": "en_US.utf8"
              },
              "dependsOn": [
                "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('serverName'))]"
              ]
            },
            {
              "type": "Microsoft.DBforPostgreSQL/flexibleServers/administrators",
              "apiVersion": "2022-12-01",
              "name": "[format('{0}/{1}', parameters('serverName'), parameters('webAppObjectId'))]",
              "properties": {
                "principalType": "ServicePrincipal",
                "principalName": "[parameters('webAppIdentityName')]",
                "tenantId": "[subscription().tenantId]"
              },
              "dependsOn": [
                "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('serverName'))]"
              ]
            },
            {
              "type": "Microsoft.DBforPostgreSQL/flexibleServers/firewallRules",
              "apiVersion": "2022-12-01",
              "name": "[format('{0}/{1}', parameters('serverName'), 'AllowAzureServices')]",
              "properties": {
                "startIpAddress": "0.0.0.0",
                "endIpAddress": "0.0.0.0"
              },
              "dependsOn": [
                "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('serverName'))]"
              ]
            }
          ],
          "outputs": {
            "serverName": {
              "type": "string",
              "metadata": {
                "description": "PostgreSQL server name"
              },
              "value": "[parameters('serverName')]"
            },
            "serverFqdn": {
              "type": "string",
              "metadata": {
                "description": "PostgreSQL server FQDN"
              },
              "value": "[reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('serverName')), '2022-12-01').fullyQualifiedDomainName]"
            },
            "databaseName": {
              "type": "string",
              "metadata": {
                "description": "Database name"
              },
              "value": "[parameters('databaseName')]"
            },
            "serverId": {
              "type": "string",
              "metadata": {
                "description": "PostgreSQL server resource ID"
              },
              "value": "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('serverName'))]"
            },
            "jdbcConnectionString": {
              "type": "string",
              "metadata": {
                "description": "PostgreSQL JDBC connection string (passwordless with Managed Identity)"
              },
              "value": "[format('jdbc:postgresql://{0}:5432/{1}', reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('serverName')), '2022-12-01').fullyQualifiedDomainName, parameters('databaseName'))]"
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Resources/deployments', 'managedIdentity')]"
      ]
    }
  ],
  "outputs": {
    "webAppIdentityId": {
      "type": "string",
      "metadata": {
        "description": "Web app managed identity resource ID"
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'managedIdentity'), '2025-04-01').outputs.webAppIdentityId.value]"
    },
    "webAppClientId": {
      "type": "string",
      "metadata": {
        "description": "Web app managed identity client ID (use as AZURE_CLIENT_ID)"
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'managedIdentity'), '2025-04-01').outputs.webAppClientId.value]"
    },
    "workerIdentityId": {
      "type": "string",
      "metadata": {
        "description": "Worker managed identity resource ID"
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'managedIdentity'), '2025-04-01').outputs.workerIdentityId.value]"
    },
    "workerClientId": {
      "type": "string",
      "metadata": {
        "description": "Worker managed identity client ID (use as AZURE_CLIENT_ID)"
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'managedIdentity'), '2025-04-01').outputs.workerClientId.value]"
    },
    "storageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Storage account name"
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'storage'), '2025-04-01').outputs.storageAccountName.value]"
    },
    "blobEndpoint": {
      "type": "string",
      "metadata": {
        "description": "Storage account blob endpoint"
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'storage'), '2025-04-01').outputs.blobEndpoint.value]"
    },
    "containerName": {
      "type": "string",
      "metadata": {
        "description": "Assets container name"
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'storage'), '2025-04-01').outputs.containerName.value]"
    },
    "serviceBusNamespaceName": {
      "type": "string",
      "metadata": {
        "description": "Service Bus namespace name"
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'serviceBus'), '2025-04-01').outputs.serviceBusNamespaceName.value]"
    },
    "serviceBusEndpoint": {
      "type": "string",
      "metadata": {
        "description": "Service Bus fully qualified domain name endpoint"
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'serviceBus'), '2025-04-01').outputs.serviceBusEndpoint.value]"
    },
    "imageProcessingQueueName": {
      "type": "string",
      "metadata": {
        "description": "Image processing queue name"
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'serviceBus'), '2025-04-01').outputs.imageProcessingQueueName.value]"
    },
    "postgresServerFqdn": {
      "type": "string",
      "metadata": {
        "description": "PostgreSQL server FQDN"
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'postgresql'), '2025-04-01').outputs.serverFqdn.value]"
    },
    "postgresDatabaseName": {
      "type": "string",
      "metadata": {
        "description": "PostgreSQL database name"
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'postgresql'), '2025-04-01').outputs.databaseName.value]"
    },
    "postgresJdbcUrl": {
      "type": "string",
      "metadata": {
        "description": "PostgreSQL JDBC connection string (passwordless, use with Managed Identity)"
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'postgresql'), '2025-04-01').outputs.jdbcConnectionString.value]"
    }
  }
}