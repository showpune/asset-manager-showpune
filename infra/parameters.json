{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "dev"
    },
    "location": {
      "value": "eastus"
    },
    "projectName": {
      "value": "assetmgr"
    },
    "postgresAdminLogin": {
      "value": "pgadmin"
    },
    "postgresAdminPassword": {
      "_comment": "REQUIRED: Replace with a secure password (min 8 chars, mix of upper/lower/digits/symbols). Do NOT commit real passwords. Pass via CLI: --parameters postgresAdminPassword=<value>",
      "value": "REPLACE_WITH_SECURE_PASSWORD"
    },
    "postgresDatabaseName": {
      "value": "assets_manager"
    },
    "serviceBusQueueName": {
      "value": "image-processing"
    },
    "assetsContainerName": {
      "value": "assets"
    },
    "thumbnailsContainerName": {
      "value": "thumbnails"
    }
  }
}
