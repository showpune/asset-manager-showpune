{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.41.2.15936",
      "templateHash": "1170620801640507411"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "metadata": {
        "description": "Location for the PostgreSQL server"
      }
    },
    "serverName": {
      "type": "string",
      "metadata": {
        "description": "Name of the PostgreSQL flexible server"
      }
    },
    "administratorLogin": {
      "type": "string",
      "metadata": {
        "description": "Administrator login username"
      }
    },
    "administratorPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Administrator login password"
      }
    },
    "skuName": {
      "type": "string",
      "defaultValue": "Standard_D2s_v3",
      "metadata": {
        "description": "SKU name for the PostgreSQL server"
      }
    },
    "skuTier": {
      "type": "string",
      "defaultValue": "GeneralPurpose",
      "allowedValues": [
        "Burstable",
        "GeneralPurpose",
        "MemoryOptimized"
      ],
      "metadata": {
        "description": "SKU tier for the PostgreSQL server"
      }
    },
    "postgresVersion": {
      "type": "string",
      "defaultValue": "16",
      "allowedValues": [
        "14",
        "15",
        "16"
      ],
      "metadata": {
        "description": "PostgreSQL version"
      }
    },
    "storageSizeGB": {
      "type": "int",
      "defaultValue": 32,
      "metadata": {
        "description": "Storage size in GB"
      }
    },
    "highAvailabilityMode": {
      "type": "string",
      "defaultValue": "Disabled",
      "allowedValues": [
        "Disabled",
        "SameZone",
        "ZoneRedundant"
      ],
      "metadata": {
        "description": "High availability mode"
      }
    },
    "databaseName": {
      "type": "string",
      "defaultValue": "assets_manager",
      "metadata": {
        "description": "Database name"
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Tags to apply to resources"
      }
    },
    "webAppObjectId": {
      "type": "string",
      "metadata": {
        "description": "Object ID of the web app managed identity (for AAD admin)"
      }
    },
    "webAppIdentityName": {
      "type": "string",
      "metadata": {
        "description": "Name of the web app managed identity"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2022-12-01",
      "name": "[parameters('serverName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "sku": {
        "name": "[parameters('skuName')]",
        "tier": "[parameters('skuTier')]"
      },
      "properties": {
        "version": "[parameters('postgresVersion')]",
        "administratorLogin": "[parameters('administratorLogin')]",
        "administratorLoginPassword": "[parameters('administratorPassword')]",
        "storage": {
          "storageSizeGB": "[parameters('storageSizeGB')]"
        },
        "backup": {
          "backupRetentionDays": 7,
          "geoRedundantBackup": "Disabled"
        },
        "highAvailability": {
          "mode": "[parameters('highAvailabilityMode')]"
        },
        "authConfig": {
          "activeDirectoryAuth": "Enabled",
          "passwordAuth": "Enabled"
        }
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/databases",
      "apiVersion": "2022-12-01",
      "name": "[format('{0}/{1}', parameters('serverName'), parameters('databaseName'))]",
      "properties": {
        "charset": "UTF8",
        "collation": "en_US.utf8"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('serverName'))]"
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/administrators",
      "apiVersion": "2022-12-01",
      "name": "[format('{0}/{1}', parameters('serverName'), parameters('webAppObjectId'))]",
      "properties": {
        "principalType": "ServicePrincipal",
        "principalName": "[parameters('webAppIdentityName')]",
        "tenantId": "[subscription().tenantId]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('serverName'))]"
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/firewallRules",
      "apiVersion": "2022-12-01",
      "name": "[format('{0}/{1}', parameters('serverName'), 'AllowAzureServices')]",
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('serverName'))]"
      ]
    }
  ],
  "outputs": {
    "serverName": {
      "type": "string",
      "metadata": {
        "description": "PostgreSQL server name"
      },
      "value": "[parameters('serverName')]"
    },
    "serverFqdn": {
      "type": "string",
      "metadata": {
        "description": "PostgreSQL server FQDN"
      },
      "value": "[reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('serverName')), '2022-12-01').fullyQualifiedDomainName]"
    },
    "databaseName": {
      "type": "string",
      "metadata": {
        "description": "Database name"
      },
      "value": "[parameters('databaseName')]"
    },
    "serverId": {
      "type": "string",
      "metadata": {
        "description": "PostgreSQL server resource ID"
      },
      "value": "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('serverName'))]"
    },
    "jdbcConnectionString": {
      "type": "string",
      "metadata": {
        "description": "PostgreSQL JDBC connection string (passwordless with Managed Identity)"
      },
      "value": "[format('jdbc:postgresql://{0}:5432/{1}', reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('serverName')), '2022-12-01').fullyQualifiedDomainName, parameters('databaseName'))]"
    }
  }
}